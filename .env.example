# Application Settings
PROJECT_NAME="Black Rice E-Commerce API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blackrice_db

# Complete SQLAlchemy Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blackrice_db
# SQLite fallback for zero-dependency local testing:
# DATABASE_URL=sqlite:///./blackrice.db

# Security & Tokens
JWT_SECRET_KEY=generate-a-secure-random-32-byte-hex-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis Cache (Optional)
REDIS_URL=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
